{
  "manifest_version": 3,
  "name": "Fluxor",
  "version": "1.0.0",
  "description": "A customizable new tab page with quick links, themes, and personalization options",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}
