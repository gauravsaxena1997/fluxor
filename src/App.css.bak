  align-items: center;
  justify-content: space-between;
  padding: 1rem;
  border-radius: 8px;
  margin-bottom: 1rem;
  position: sticky;
  top: 0;
  z-index: 10;
  background: transparent;
  box-shadow: none;
}

/* Links section content - the scrollable part */
.links-section-content {
  padding: 0 1rem 1rem;
  overflow-y: auto;
  height: calc(100% - 60px); /* Adjust height to account for header */
  position: relative;
}

/* Remove background for header in both light and dark theme */
.dark-theme .links-section-header {
  background: transparent;
  box-shadow: none;
}

